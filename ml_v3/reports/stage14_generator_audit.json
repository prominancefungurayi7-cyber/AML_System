  "findings": [
    {
      "finding": "Frozen truth materialization imports reference_evaluator.evaluate_rows, not reference.ReferenceEvaluator. A1 reconstruction against frozen labels confirms this source path on both development partitions.",
      "line": 8,
      "source": "ml_v3/src/generate_v3.py"
    },
    {
      "finding": "Final decision_point_target is bool(frozen evidence families), independent of private routine/hard/campaign origin. Legitimate-like origin rows crossing A1 gates become target1 and disappear from target0 overlap comparisons.",
      "line": 65,
      "source": "ml_v3/src/generate_v3.py"
    },
    {
      "finding": "Routine events sample active wallets broadly across six 30d blocks; agent selection uses fixed activity-band weights .5/1/2. The source has no explicit evolving ordinary agent catchment, customer-acquisition campaign, or seasonal wallet-population process.",
      "line": 206,
      "source": "ml_v2/src/dataset_generator.py"
    },
    {
      "finding": "Both A1 and H7/A1 select 4..min(16,n-1) counterparts with lowest preceding 30d service frequency. Wallets are cycled through, with a previously seen wallet in the final position when available. This encourages novelty; it does not set the final growth ratio to a constant.",
      "line": 256,
      "source": "ml_v2/src/dataset_generator.py"
    },
    {
      "finding": "A2/H8-A2 choose 2..min(6,n/2) concentration wallets; 35%..85% of episode events use them, with remaining events sampled outside that subset. Growth is not a direct A2 primitive.",
      "line": 262,
      "source": "ml_v2/src/dataset_generator.py"
    },
    {
      "finding": "A3/H7-A3 use 2..4 temporal clusters with within-cluster width .2 before scaling to episode duration; serviced wallets otherwise sampled broadly. This supplies burst information, not a growth substitute.",
      "line": 333,
      "source": "ml_v2/src/dataset_generator.py"
    },
    {
      "finding": "A4/H8-A4 guarantee an opening two-versus-one cash direction portion and sample amounts until dominant value share is 60%..95%. Subsequent events, history and target conjunction determine whether A4 fires.",
      "line": 271,
      "source": "ml_v2/src/dataset_generator.py"
    },
    {
      "finding": "H7 maps to A1/A3 and H8 to A2/A4 through the shared scenario manifest. Hard episodes contain 6..24 events; agent campaign episodes 6..30. Hard coordination is uniform .1..8; campaign strengths use .25/.55/.8. Support overlaps rather than separate fixed positive/negative ratios.",
      "line": 184,
      "source": "ml_v2/src/dataset_generator.py"
    },
    {
      "finding": "Episode durations and starts are bounded inside 30d blocks. A1 uses 1..7 days, A2/A4 .25..7 days, A3 900..7200 seconds. Boundary endpoints are explicitly included. These are synthetic temporal templates, with no independent empirical calibration.",
      "line": 224,
      "source": "ml_v2/src/dataset_generator.py"
